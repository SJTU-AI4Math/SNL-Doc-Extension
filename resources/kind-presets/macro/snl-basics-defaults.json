{
  "schema": "snl-doc.kind-preset",
  "version": 2,
  "domain": "macro",
  "id": "snl-basics-defaults",
  "copyKeys": {
    "label": "basicsLabel",
    "description": "basicsDescription"
  },
  "kinds": [
    {
      "id": "rule",
      "name": "Rule",
      "description": "Meta-mathematical rule symbols (∀, ∃, `:`, `def`, apply, implies, paren…).",
      "coloring": {
        "light": {
          "stroke": "#009C27",
          "background": "#D6FEE0"
        },
        "dark": {
          "stroke": "#009C27",
          "background": "#D6FEE0"
        }
      }
    },
    {
      "id": "const",
      "name": "Const",
      "description": "Mathematical constants / defined terms (add, mul, and, or…).",
      "coloring": {
        "light": {
          "stroke": "#005B9C",
          "background": "#DAF0FF"
        },
        "dark": {
          "stroke": "#005B9C",
          "background": "#DAF0FF"
        }
      }
    },
    {
      "id": "bvar",
      "name": "Bound variable",
      "description": "Bound-variable occurrences.",
      "coloring": {
        "light": {
          "stroke": "#7700E4",
          "background": "#EFDFFF"
        },
        "dark": {
          "stroke": "#7700E4",
          "background": "#EFDFFF"
        }
      }
    },
    {
      "id": "binder",
      "name": "Binder",
      "description": "Binding sites (∀-`x`, λ parameter, informal `dx`…).",
      "coloring": {
        "light": {
          "stroke": "#E07B00",
          "background": "#FFEBD2"
        },
        "dark": {
          "stroke": "#E07B00",
          "background": "#FFEBD2"
        }
      }
    },
    {
      "id": "fvar",
      "name": "Free variable",
      "description": "Free variables (undefined, effectively `sorry`s).",
      "coloring": {
        "light": {
          "stroke": "#D20022",
          "background": "#FFD6DC"
        },
        "dark": {
          "stroke": "#D20022",
          "background": "#FFD6DC"
        }
      }
    },
    {
      "id": "sub",
      "name": "Subtree helper",
      "description": "Helper subtree that is NOT a complete syntactic node — e.g. a matrix.row inside a Matrix macro. Rendered with no visual frame, and hover feedback skips over it to its parent macro. Use for implementation-only intermediate macros that shouldn't attract user attention.",
      "coloring": {
        "light": {
          "stroke": "inherit",
          "background": "transparent"
        },
        "dark": {
          "stroke": "inherit",
          "background": "transparent"
        }
      }
    }
  ]
}
