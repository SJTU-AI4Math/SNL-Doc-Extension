{
  "name": "snl-doc-extension",
  "displayName": "SNL Doc",
  "description": "VS Code extension for SNL documentation with an Infoview webview panel.",
  "publisher": "sjtu-ai4math",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "snlDoc.openInfoview",
        "title": "SNL: Open Infoview"
      },
      {
        "command": "snlDoc.refreshInfoview",
        "title": "SNL: Refresh Infoview"
      },
      {
        "command": "snlDoc.deleteEntry",
        "title": "SNL: Delete Entry",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteEntryKind",
        "title": "SNL: Delete Entry Kind",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroKind",
        "title": "SNL: Delete Macro Kind",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteLibrary",
        "title": "SNL: Delete Library",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroPackage",
        "title": "SNL: Delete Macro Package",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openEntryInfoview",
        "title": "SNL: Open Entry Infoview"
      },
      {
        "command": "snlDoc.revealEntryPointer",
        "title": "SNL: Reveal Entry Pointer",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openDashboard",
        "title": "SNL: Open Dashboard"
      },
      {
        "command": "snlDoc.init",
        "title": "SNL: Init"
      },
      {
        "command": "snlDoc.createLibrary",
        "title": "SNL: Create Library"
      },
      {
        "command": "snlDoc.initEntryKinds",
        "title": "SNL: Initialize Entry Kinds"
      },
      {
        "command": "snlDoc.createEntryKind",
        "title": "SNL: Create Entry Kind"
      },
      {
        "command": "snlDoc.initMacroKinds",
        "title": "SNL: Initialize Macro Kinds"
      },
      {
        "command": "snlDoc.createMacroKind",
        "title": "SNL: Create Macro Kind"
      },
      {
        "command": "snlDoc.createEntry",
        "title": "SNL: Create Entry"
      },
      {
        "command": "snlDoc.createMacroPackage",
        "title": "SNL: Create Macro Package"
      },
      {
        "command": "snlDoc.openMacroPackage",
        "title": "SNL: Open Macro Package…"
      },
      {
        "command": "snlDoc.createMacro",
        "title": "SNL: Create Macro"
      },
      {
        "command": "snlDoc.editLibrary",
        "title": "SNL: Edit Library"
      },
      {
        "command": "snlDoc.editEntryKind",
        "title": "SNL: Edit Entry Kind"
      },
      {
        "command": "snlDoc.editMacroKind",
        "title": "SNL: Edit Macro Kind"
      },
      {
        "command": "snlDoc.editEntry",
        "title": "SNL: Edit Entry"
      },
      {
        "command": "snlDoc.editMacroPackage",
        "title": "SNL: Edit Macro Package"
      },
      {
        "command": "snlDoc.editMacro",
        "title": "SNL: Edit Macro"
      },
      {
        "command": "snlDoc.createRelationship",
        "title": "SNL: Create Relationship"
      },
      {
        "command": "snlDoc.editRelationship",
        "title": "SNL: Edit Relationship"
      },
      {
        "command": "snlDoc.deleteRelationship",
        "title": "SNL: Delete Relationship",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openInfoviewGraph",
        "title": "SNL: Open Relationship Graph"
      },
      {
        "command": "snlDoc.openInfoviewGraphForLibrary",
        "title": "SNL: Open Relationship Graph (Library)"
      },
      {
        "command": "snlDoc.regenerateDependencies",
        "title": "SNL: Regenerate Dependency Relationships"
      },
      {
        "command": "snlDoc.openSnoogL",
        "title": "SNL: Open SNoogL (Search)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "snlDoc.openEntryInfoview",
          "when": "false"
        },
        {
          "command": "snlDoc.openMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.createMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editLibrary",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntryKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntry",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editRelationship",
          "when": "false"
        },
        {
          "command": "snlDoc.openInfoviewGraphForLibrary",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SNL Doc",
      "properties": {
        "snlDoc.metrics.semanticFreedomGreenBelow": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Semantic freedom values below this threshold are shown in green."
        },
        "snlDoc.metrics.semanticFreedomRedAbove": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Semantic freedom values above this threshold are shown in red; values between the two thresholds are orange."
        },
        "snlDoc.metrics.structuredRatioRedBelow": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 100,
          "description": "Structured percentages below this threshold are shown in red."
        },
        "snlDoc.metrics.structuredRatioGreenAtLeast": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Structured percentages at or above this threshold are shown in green; values between the two thresholds are orange."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-snl-basics.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "snl:rebuild": "node scripts/rebuild-snl-basics.mjs --force",
    "compile": "node scripts/rebuild-snl-basics.mjs && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node scripts/rebuild-snl-basics.mjs && npm run build:webview:main && npm run build:webview:entryInfoview && npm run build:webview:createLibrary && npm run build:webview:dashboard && npm run build:webview:initEntryKinds && npm run build:webview:createEntryKind && npm run build:webview:initMacroKinds && npm run build:webview:createMacroKind && npm run build:webview:createEntry && npm run build:webview:createMacroPackage && npm run build:webview:packagePanel && npm run build:webview:createMacro && npm run build:webview:createRelationship && npm run build:webview:snlGraph && npm run build:webview:snoogl",
    "build:webview:main": "cross-env SNL_WEBVIEW_ENTRY=main vite build --config webview/vite.config.ts",
    "build:webview:entryInfoview": "cross-env SNL_WEBVIEW_ENTRY=entryInfoview vite build --config webview/vite.config.ts",
    "build:webview:createLibrary": "cross-env SNL_WEBVIEW_ENTRY=createLibrary vite build --config webview/vite.config.ts",
    "build:webview:dashboard": "cross-env SNL_WEBVIEW_ENTRY=dashboard vite build --config webview/vite.config.ts",
    "build:webview:initEntryKinds": "cross-env SNL_WEBVIEW_ENTRY=initEntryKinds vite build --config webview/vite.config.ts",
    "build:webview:createEntryKind": "cross-env SNL_WEBVIEW_ENTRY=createEntryKind vite build --config webview/vite.config.ts",
    "build:webview:initMacroKinds": "cross-env SNL_WEBVIEW_ENTRY=initMacroKinds vite build --config webview/vite.config.ts",
    "build:webview:createMacroKind": "cross-env SNL_WEBVIEW_ENTRY=createMacroKind vite build --config webview/vite.config.ts",
    "build:webview:createEntry": "cross-env SNL_WEBVIEW_ENTRY=createEntry vite build --config webview/vite.config.ts",
    "build:webview:createMacroPackage": "cross-env SNL_WEBVIEW_ENTRY=createMacroPackage vite build --config webview/vite.config.ts",
    "build:webview:packagePanel": "cross-env SNL_WEBVIEW_ENTRY=packagePanel vite build --config webview/vite.config.ts",
    "build:webview:createMacro": "cross-env SNL_WEBVIEW_ENTRY=createMacro vite build --config webview/vite.config.ts",
    "build:webview:createRelationship": "cross-env SNL_WEBVIEW_ENTRY=createRelationship vite build --config webview/vite.config.ts",
    "build:webview:snlGraph": "cross-env SNL_WEBVIEW_ENTRY=snlGraph vite build --config webview/vite.config.ts",
    "build:webview:snoogl": "cross-env SNL_WEBVIEW_ENTRY=snoogl vite build --config webview/vite.config.ts",
    "dev:webview": "vite --config webview/vite.config.ts",
    "smoke": "npm run compile && node scripts/smoke.mjs",
    "test:metrics": "external/SNL-Basics/node_modules/.bin/vitest run webview/src/components/EntryMetrics.test.ts --environment node",
    "setup-snl": "node scripts/setup-submodule.mjs",
    "rebuild-snl": "cd external/SNL-Basics && npm run build:lib",
    "vscode:prepublish": "npm run compile && npm run build:webview"
  },
  "dependencies": {
    "@snl-basics/react": "file:./external/SNL-Basics",
    "katex": "^0.16.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.3",
    "vite": "^8"
  }
}
