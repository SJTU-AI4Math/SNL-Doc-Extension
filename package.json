{
  "name": "snl-doc-extension",
  "displayName": "%snlDoc.displayName%",
  "description": "%snlDoc.description%",
  "publisher": "sjtu-ai4math",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.SNL_Doc/config.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snlDoc.openInfoview",
        "title": "%snlDoc.command.openInfoview%"
      },
      {
        "command": "snlDoc.refreshInfoview",
        "title": "%snlDoc.command.refreshInfoview%"
      },
      {
        "command": "snlDoc.deleteEntry",
        "title": "%snlDoc.command.deleteEntry%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteEntryKind",
        "title": "%snlDoc.command.deleteEntryKind%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroKind",
        "title": "%snlDoc.command.deleteMacroKind%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteLibrary",
        "title": "%snlDoc.command.deleteLibrary%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroPackage",
        "title": "%snlDoc.command.deleteMacroPackage%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openEntryInfoview",
        "title": "%snlDoc.command.openEntryInfoview%"
      },
      {
        "command": "snlDoc.revealEntryPointer",
        "title": "%snlDoc.command.revealEntryPointer%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openDashboard",
        "title": "%snlDoc.command.openDashboard%",
        "icon": {
          "light": "media/icons/cat-light.svg",
          "dark": "media/icons/cat-dark.svg"
        }
      },
      {
        "command": "snlDoc.toggleTrace",
        "title": "%snlDoc.command.toggleTrace%"
      },
      {
        "command": "snlDoc.probeWebviewCost",
        "title": "%snlDoc.command.probeWebviewCost%"
      },
      {
        "command": "snlDoc.init",
        "title": "%snlDoc.command.init%"
      },
      {
        "command": "snlDoc.createLibrary",
        "title": "%snlDoc.command.createLibrary%"
      },
      {
        "command": "snlDoc.initEntryKinds",
        "title": "%snlDoc.command.initEntryKinds%"
      },
      {
        "command": "snlDoc.createEntryKind",
        "title": "%snlDoc.command.createEntryKind%"
      },
      {
        "command": "snlDoc.initMacroKinds",
        "title": "%snlDoc.command.initMacroKinds%"
      },
      {
        "command": "snlDoc.createMacroKind",
        "title": "%snlDoc.command.createMacroKind%"
      },
      {
        "command": "snlDoc.createEntry",
        "title": "%snlDoc.command.createEntry%"
      },
      {
        "command": "snlDoc.createMacroPackage",
        "title": "%snlDoc.command.createMacroPackage%"
      },
      {
        "command": "snlDoc.openMacroPackage",
        "title": "%snlDoc.command.openMacroPackage%"
      },
      {
        "command": "snlDoc.createMacro",
        "title": "%snlDoc.command.createMacro%"
      },
      {
        "command": "snlDoc.editLibrary",
        "title": "%snlDoc.command.editLibrary%"
      },
      {
        "command": "snlDoc.editEntryKind",
        "title": "%snlDoc.command.editEntryKind%"
      },
      {
        "command": "snlDoc.editMacroKind",
        "title": "%snlDoc.command.editMacroKind%"
      },
      {
        "command": "snlDoc.editEntry",
        "title": "%snlDoc.command.editEntry%"
      },
      {
        "command": "snlDoc.editMacroPackage",
        "title": "%snlDoc.command.editMacroPackage%"
      },
      {
        "command": "snlDoc.editMacro",
        "title": "%snlDoc.command.editMacro%"
      },
      {
        "command": "snlDoc.createRelationship",
        "title": "%snlDoc.command.createRelationship%"
      },
      {
        "command": "snlDoc.editRelationship",
        "title": "%snlDoc.command.editRelationship%"
      },
      {
        "command": "snlDoc.deleteRelationship",
        "title": "%snlDoc.command.deleteRelationship%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openInfoviewGraph",
        "title": "%snlDoc.command.openInfoviewGraph%"
      },
      {
        "command": "snlDoc.openInfoviewGraphForLibrary",
        "title": "%snlDoc.command.openInfoviewGraphForLibrary%"
      },
      {
        "command": "snlDoc.regenerateDependencies",
        "title": "%snlDoc.command.regenerateDependencies%"
      },
      {
        "command": "snlDoc.openSnoogL",
        "title": "%snlDoc.command.openSnoogL%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "snlDoc.openDashboard",
          "group": "navigation@100",
          "when": "snlDoc.hasSnlDoc"
        }
      ],
      "commandPalette": [
        {
          "command": "snlDoc.openEntryInfoview",
          "when": "false"
        },
        {
          "command": "snlDoc.openMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.createMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editLibrary",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntryKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntry",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editRelationship",
          "when": "false"
        },
        {
          "command": "snlDoc.openInfoviewGraphForLibrary",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%snlDoc.settings.title%",
      "properties": {
        "snlDoc.openBeside": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Open SNL editor panels in a new group beside the current editor, instead of taking over it. Note: this was tried as a performance fix and measured as a non-cause (Active 1077ms vs Beside 1096ms); it is a layout preference only."
        },
        "snlDoc.trace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Log millisecond-resolution panel open/render timings to the \"SNL Trace\" output channel. For diagnosing slow panels; off by default."
        },
        "snlDoc.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.locale.description%"
        },
        "snlDoc.appearance.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "high-contrast",
            "high-contrast-light"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.theme.description%"
        },
        "snlDoc.appearance.motion": {
          "type": "string",
          "enum": [
            "auto",
            "full",
            "reduced"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.motion.description%"
        },
        "snlDoc.metrics.structuralIndexRedBelow": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 100,
          "description": "SNL Structural Index percentages below this threshold are shown in red."
        },
        "snlDoc.metrics.structuralIndexGreenAtLeast": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "SNL Structural Index percentages at or above this threshold are shown in green; values between the two thresholds are orange."
        }
      }
    }
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "compile": "node scripts/clean-out.mjs && tsc -p ./",
    "build:export-runtime": "node scripts/build-export-runtime.mjs",
    "watch": "tsc -watch -p ./",
    "build:webview": "npm run build:webview:main && npm run build:webview:entryInfoview && npm run build:webview:createLibrary && npm run build:webview:dashboard && npm run build:webview:initEntryKinds && npm run build:webview:createEntryKind && npm run build:webview:initMacroKinds && npm run build:webview:createMacroKind && npm run build:webview:createEntry && npm run build:webview:createMacroPackage && npm run build:webview:packagePanel && npm run build:webview:createMacro && npm run build:webview:createRelationship && npm run build:webview:snlGraph && npm run build:webview:snoogl && npm run build:webview:exportOptions",
    "build:webview:main": "cross-env SNL_WEBVIEW_ENTRY=main vite build --config webview/vite.config.ts",
    "build:webview:entryInfoview": "cross-env SNL_WEBVIEW_ENTRY=entryInfoview vite build --config webview/vite.config.ts",
    "build:webview:createLibrary": "cross-env SNL_WEBVIEW_ENTRY=createLibrary vite build --config webview/vite.config.ts",
    "build:webview:dashboard": "cross-env SNL_WEBVIEW_ENTRY=dashboard vite build --config webview/vite.config.ts",
    "build:webview:initEntryKinds": "cross-env SNL_WEBVIEW_ENTRY=initEntryKinds vite build --config webview/vite.config.ts",
    "build:webview:createEntryKind": "cross-env SNL_WEBVIEW_ENTRY=createEntryKind vite build --config webview/vite.config.ts",
    "build:webview:initMacroKinds": "cross-env SNL_WEBVIEW_ENTRY=initMacroKinds vite build --config webview/vite.config.ts",
    "build:webview:createMacroKind": "cross-env SNL_WEBVIEW_ENTRY=createMacroKind vite build --config webview/vite.config.ts",
    "build:webview:createEntry": "cross-env SNL_WEBVIEW_ENTRY=createEntry vite build --config webview/vite.config.ts",
    "build:webview:createMacroPackage": "cross-env SNL_WEBVIEW_ENTRY=createMacroPackage vite build --config webview/vite.config.ts",
    "build:webview:packagePanel": "cross-env SNL_WEBVIEW_ENTRY=packagePanel vite build --config webview/vite.config.ts",
    "build:webview:createMacro": "cross-env SNL_WEBVIEW_ENTRY=createMacro vite build --config webview/vite.config.ts",
    "build:webview:createRelationship": "cross-env SNL_WEBVIEW_ENTRY=createRelationship vite build --config webview/vite.config.ts",
    "build:webview:snlGraph": "cross-env SNL_WEBVIEW_ENTRY=snlGraph vite build --config webview/vite.config.ts",
    "build:webview:snoogl": "cross-env SNL_WEBVIEW_ENTRY=snoogl vite build --config webview/vite.config.ts",
    "dev:webview": "vite --config webview/vite.config.ts",
    "smoke": "npm run compile && node scripts/smoke.mjs",
    "test": "npm run build:export-runtime && vitest run",
    "test:metrics": "vitest run webview/src/components/EntryMetrics.test.ts --environment node",
    "vscode:prepublish": "npm test && npm run compile && npm run build:export-runtime && npm run build:webview",
    "build:webview:exportOptions": "cross-env SNL_WEBVIEW_ENTRY=exportOptions vite build --config webview/vite.config.ts"
  },
  "dependencies": {
    "@sjtu-ai4math/snl-basics": "^0.1.1",
    "fuse.js": "^7.5.0",
    "katex": "^0.16.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^3.2.6"
  }
}
