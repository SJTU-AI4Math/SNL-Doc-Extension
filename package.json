{
  "name": "snl-doc-extension",
  "displayName": "SNL Doc",
  "description": "VS Code extension for SNL documentation with an Infoview webview panel.",
  "publisher": "sjtu-ai4math",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "snlDoc.openInfoview",
        "title": "SNL: Open Infoview"
      },
      {
        "command": "snlDoc.openDashboard",
        "title": "SNL: Open Dashboard"
      },
      {
        "command": "snlDoc.init",
        "title": "SNL: Init"
      },
      {
        "command": "snlDoc.createLibrary",
        "title": "SNL: Create Library"
      },
      {
        "command": "snlDoc.initEntryKinds",
        "title": "SNL: Initialize Entry Kinds"
      },
      {
        "command": "snlDoc.createEntryKind",
        "title": "SNL: Create Entry Kind"
      },
      {
        "command": "snlDoc.createEntry",
        "title": "SNL: Create Entry"
      },
      {
        "command": "snlDoc.createMacroPackage",
        "title": "SNL: Create Macro Package"
      },
      {
        "command": "snlDoc.openMacroPackage",
        "title": "SNL: Open Macro Package…"
      },
      {
        "command": "snlDoc.createMacro",
        "title": "SNL: Create Macro"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "snlDoc.openMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.createMacro",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-snl-basics.mjs",
    "snl:rebuild": "node scripts/rebuild-snl-basics.mjs --force",
    "compile": "node scripts/rebuild-snl-basics.mjs && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node scripts/rebuild-snl-basics.mjs && npm run build:webview:main && npm run build:webview:createLibrary && npm run build:webview:dashboard && npm run build:webview:initEntryKinds && npm run build:webview:createEntryKind && npm run build:webview:createEntry && npm run build:webview:createMacroPackage && npm run build:webview:packagePanel && npm run build:webview:createMacro",
    "build:webview:main": "cross-env SNL_WEBVIEW_ENTRY=main vite build --config webview/vite.config.ts",
    "build:webview:createLibrary": "cross-env SNL_WEBVIEW_ENTRY=createLibrary vite build --config webview/vite.config.ts",
    "build:webview:dashboard": "cross-env SNL_WEBVIEW_ENTRY=dashboard vite build --config webview/vite.config.ts",
    "build:webview:initEntryKinds": "cross-env SNL_WEBVIEW_ENTRY=initEntryKinds vite build --config webview/vite.config.ts",
    "build:webview:createEntryKind": "cross-env SNL_WEBVIEW_ENTRY=createEntryKind vite build --config webview/vite.config.ts",
    "build:webview:createEntry": "cross-env SNL_WEBVIEW_ENTRY=createEntry vite build --config webview/vite.config.ts",
    "build:webview:createMacroPackage": "cross-env SNL_WEBVIEW_ENTRY=createMacroPackage vite build --config webview/vite.config.ts",
    "build:webview:packagePanel": "cross-env SNL_WEBVIEW_ENTRY=packagePanel vite build --config webview/vite.config.ts",
    "build:webview:createMacro": "cross-env SNL_WEBVIEW_ENTRY=createMacro vite build --config webview/vite.config.ts",
    "dev:webview": "vite --config webview/vite.config.ts",
    "smoke": "npm run compile && node scripts/smoke.mjs",
    "setup-snl": "node scripts/setup-submodule.mjs",
    "rebuild-snl": "cd external/SNL-Basics && npm run build:lib",
    "vscode:prepublish": "npm run compile && npm run build:webview"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "katex": "^0.16.0",
    "@snl-basics/react": "file:./external/SNL-Basics"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.3",
    "vite": "^8"
  }
}
