{
  "name": "snl-doc-extension",
  "displayName": "%snlDoc.displayName%",
  "description": "%snlDoc.description%",
  "publisher": "sjtu-ai4math",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SJTU-AI4Math/SNL-Doc-Extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.SNL_Doc/config.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snlDoc.openInfoview",
        "title": "%snlDoc.command.openInfoview%"
      },
      {
        "command": "snlDoc.refreshInfoview",
        "title": "%snlDoc.command.refreshInfoview%"
      },
      {
        "command": "snlDoc.deleteEntry",
        "title": "%snlDoc.command.deleteEntry%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteEntryKind",
        "title": "%snlDoc.command.deleteEntryKind%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroKind",
        "title": "%snlDoc.command.deleteMacroKind%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteLibrary",
        "title": "%snlDoc.command.deleteLibrary%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.deleteMacroPackage",
        "title": "%snlDoc.command.deleteMacroPackage%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openEntryInfoview",
        "title": "%snlDoc.command.openEntryInfoview%"
      },
      {
        "command": "snlDoc.revealEntryPointer",
        "title": "%snlDoc.command.revealEntryPointer%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openDashboard",
        "title": "%snlDoc.command.openDashboard%"
      },
      {
        "command": "snlDoc.openNavigation",
        "title": "%snlDoc.command.openNavigation%",
        "icon": {
          "light": "media/icons/cat-light.svg",
          "dark": "media/icons/cat-dark.svg"
        }
      },
      {
        "command": "snlDoc.checkDataVersion",
        "title": "%snlDoc.command.checkDataVersion%"
      },
      {
        "command": "snlDoc.repairData",
        "title": "%snlDoc.command.repairData%"
      },
      {
        "command": "snlDoc.toggleTrace",
        "title": "%snlDoc.command.toggleTrace%"
      },
      {
        "command": "snlDoc.probeWebviewCost",
        "title": "%snlDoc.command.probeWebviewCost%"
      },
      {
        "command": "snlDoc.init",
        "title": "%snlDoc.command.init%"
      },
      {
        "command": "snlDoc.createLibrary",
        "title": "%snlDoc.command.createLibrary%"
      },
      {
        "command": "snlDoc.initEntryKinds",
        "title": "%snlDoc.command.initEntryKinds%"
      },
      {
        "command": "snlDoc.createEntryKind",
        "title": "%snlDoc.command.createEntryKind%"
      },
      {
        "command": "snlDoc.initMacroKinds",
        "title": "%snlDoc.command.initMacroKinds%"
      },
      {
        "command": "snlDoc.createMacroKind",
        "title": "%snlDoc.command.createMacroKind%"
      },
      {
        "command": "snlDoc.createEntry",
        "title": "%snlDoc.command.createEntry%"
      },
      {
        "command": "snlDoc.createEntryPackage",
        "title": "%snlDoc.command.createEntryPackage%"
      },
      {
        "command": "snlDoc.openEntryPackage",
        "title": "%snlDoc.command.openEntryPackage%"
      },
      {
        "command": "snlDoc.createMacroPackage",
        "title": "%snlDoc.command.createMacroPackage%"
      },
      {
        "command": "snlDoc.openMacroPackage",
        "title": "%snlDoc.command.openMacroPackage%"
      },
      {
        "command": "snlDoc.createMacro",
        "title": "%snlDoc.command.createMacro%"
      },
      {
        "command": "snlDoc.editLibrary",
        "title": "%snlDoc.command.editLibrary%"
      },
      {
        "command": "snlDoc.editEntryKind",
        "title": "%snlDoc.command.editEntryKind%"
      },
      {
        "command": "snlDoc.editMacroKind",
        "title": "%snlDoc.command.editMacroKind%"
      },
      {
        "command": "snlDoc.editEntry",
        "title": "%snlDoc.command.editEntry%"
      },
      {
        "command": "snlDoc.editMacroPackage",
        "title": "%snlDoc.command.editMacroPackage%"
      },
      {
        "command": "snlDoc.editMacro",
        "title": "%snlDoc.command.editMacro%"
      },
      {
        "command": "snlDoc.createRelationship",
        "title": "%snlDoc.command.createRelationship%"
      },
      {
        "command": "snlDoc.editRelationship",
        "title": "%snlDoc.command.editRelationship%"
      },
      {
        "command": "snlDoc.deleteRelationship",
        "title": "%snlDoc.command.deleteRelationship%",
        "enablement": "false"
      },
      {
        "command": "snlDoc.openInfoviewGraph",
        "title": "%snlDoc.command.openInfoviewGraph%"
      },
      {
        "command": "snlDoc.openInfoviewGraphForLibrary",
        "title": "%snlDoc.command.openInfoviewGraphForLibrary%"
      },
      {
        "command": "snlDoc.regenerateDependencies",
        "title": "%snlDoc.command.regenerateDependencies%"
      },
      {
        "command": "snlDoc.openSnoogL",
        "title": "%snlDoc.command.openSnoogL%"
      },
      {
        "command": "snlDoc.inductive.moveUp",
        "title": "%snlDoc.command.inductive.moveUp%"
      },
      {
        "command": "snlDoc.inductive.moveDown",
        "title": "%snlDoc.command.inductive.moveDown%"
      },
      {
        "command": "snlDoc.inductive.outdent",
        "title": "%snlDoc.command.inductive.outdent%"
      },
      {
        "command": "snlDoc.inductive.indent",
        "title": "%snlDoc.command.inductive.indent%"
      },
      {
        "command": "snlDoc.inductive.extractSelection",
        "title": "%snlDoc.command.inductive.extractSelection%"
      },
      {
        "command": "snlDoc.inductive.addParent",
        "title": "%snlDoc.command.inductive.addParent%"
      },
      {
        "command": "snlDoc.inductive.addSibling",
        "title": "%snlDoc.command.inductive.addSibling%"
      },
      {
        "command": "snlDoc.inductive.openStyle",
        "title": "%snlDoc.command.inductive.openStyle%"
      },
      {
        "command": "snlDoc.inductive.previousField",
        "title": "%snlDoc.command.inductive.previousField%"
      },
      {
        "command": "snlDoc.inductive.nextNode",
        "title": "%snlDoc.command.inductive.nextNode%"
      },
      {
        "command": "snlDoc.inductive.undo",
        "title": "%snlDoc.command.inductive.undo%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "snlDoc.openNavigation",
          "group": "navigation@-100",
          "when": "snlDoc.hasSnlDoc"
        }
      ],
      "commandPalette": [
        {
          "command": "snlDoc.openEntryInfoview",
          "when": "false"
        },
        {
          "command": "snlDoc.openEntryPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.openMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.createMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editLibrary",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntryKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroKind",
          "when": "false"
        },
        {
          "command": "snlDoc.editEntry",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacroPackage",
          "when": "false"
        },
        {
          "command": "snlDoc.editMacro",
          "when": "false"
        },
        {
          "command": "snlDoc.editRelationship",
          "when": "false"
        },
        {
          "command": "snlDoc.openInfoviewGraphForLibrary",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%snlDoc.settings.title%",
      "properties": {
        "snlDoc.openBeside": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%snlDoc.settings.openBeside.description%"
        },
        "snlDoc.trace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%snlDoc.settings.trace.description%"
        },
        "snlDoc.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.locale.description%"
        },
        "snlDoc.appearance.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "high-contrast",
            "high-contrast-light"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.theme.description%"
        },
        "snlDoc.appearance.motion": {
          "type": "string",
          "enum": [
            "auto",
            "full",
            "reduced"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%snlDoc.settings.motion.description%"
        },
        "snlDoc.editor.formatter.indentSpaces": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 256,
          "scope": "window",
          "description": "%snlDoc.settings.formatter.indentSpaces.description%"
        },
        "snlDoc.editor.formatter.inlineParenthesisDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 9007199254740991,
          "scope": "window",
          "description": "%snlDoc.settings.formatter.inlineParenthesisDepth.description%"
        },
        "snlDoc.popovers.openOnHover": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%snlDoc.settings.popovers.openOnHover.description%"
        },
        "snlDoc.metrics.structuralIndexRedBelow": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 100,
          "description": "%snlDoc.settings.structuralIndexRedBelow.description%"
        },
        "snlDoc.metrics.structuralIndexGreenAtLeast": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "%snlDoc.settings.structuralIndexGreenAtLeast.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "snlDoc.inductive.moveUp",
        "key": "alt+up",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.moveDown",
        "key": "alt+down",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.outdent",
        "key": "alt+left",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.indent",
        "key": "alt+right",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.extractSelection",
        "key": "alt+x",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.addParent",
        "key": "alt+p",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.addSibling",
        "key": "alt+s",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.openStyle",
        "key": "tab",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus && !snl.inductiveAutocompleteOwnsTab"
      },
      {
        "command": "snlDoc.inductive.previousField",
        "key": "shift+tab",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.nextNode",
        "key": "enter",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      },
      {
        "command": "snlDoc.inductive.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == snlCreateEntry && snlDoc.inductiveInputFocus"
      }
    ]
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "sync:dependencies": "npm install --include=dev --no-audit --no-fund",
    "compile": "node scripts/clean-out.mjs && tsc -p ./ && npm run build:host-basics",
    "build:host-basics": "node scripts/build-snl-basics-host.mjs",
    "build:export-runtime": "node scripts/build-export-runtime.mjs",
    "watch": "npm run build:host-basics && tsc -watch -p ./",
    "build:webview": "node scripts/build-webviews.mjs",
    "dev:webview": "vite --config webview/vite.config.ts",
    "smoke": "npm run compile && node scripts/smoke.mjs",
    "test": "node scripts/prepare-test-artifacts.mjs && vitest run",
    "verify:ui-spec": "npm run compile --silent && node out/uiSpecVerifier.js",
    "test:metrics": "vitest run webview/src/components/EntryMetrics.test.ts --environment node",
    "test:entry-overflow": "node scripts/test-entry-overflow-geometry.mjs",
    "test:library-paint": "node scripts/test-library-row-paint-occlusion.mjs",
    "test:library-depth-row": "node scripts/test-library-depth-row-geometry.mjs",
    "test:library-depth-row:contracts": "node scripts/test-library-depth-harness-contracts.mjs",
    "test:library-depth-row:mutations": "node scripts/test-library-depth-row-mutations.mjs",
    "test:create-entry-paint": "node scripts/test-create-entry-row-paint-occlusion.mjs",
    "vscode:prepublish": "npm test && npm run compile && npm run build:export-runtime && npm run build:webview",
    "smoke:vsix-host": "node scripts/smoke-vsix-host.mjs"
  },
  "dependencies": {
    "@sjtu-ai4math/snl-basics": "0.3.2",
    "fuse.js": "^7.5.0",
    "katex": "^0.16.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "^5",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "monaco-editor": "0.53.0",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "homepage": "https://github.com/SJTU-AI4Math/SNL-Doc-Extension#readme",
  "bugs": {
    "url": "https://github.com/SJTU-AI4Math/SNL-Doc-Extension/issues"
  }
}
